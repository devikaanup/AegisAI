GEMINI_API_KEY=your_key_here
# Optional model override (defaults to gemini-2.5-flash in config.ts)
GEMINI_MODEL=gemini-2.5-flash

# MapTiler API key for 3D building basemap tiles.
# This is a PUBLISHABLE, domain-restricted client key (MapTiler's documented convention).
# It is intentionally in NEXT_PUBLIC_* and will appear in browser requests — that is expected
# and safe. It is secured by allowed-domain restriction in the MapTiler dashboard.
# This is completely separate from GEMINI_API_KEY, which remains server-only.
# If unset, the app falls back to an offline schematic map; routing and simulation are unaffected.
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
